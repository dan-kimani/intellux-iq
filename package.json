{
  "name": "intelluxiq",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/desktop",
    "apps/web",
    "apps/api",
    "apps/sync",
    "apps/worker",
    "packages/*",
    "packages/features/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "bun run format:check && oxlint --deny-warnings apps packages scripts && bun run lint:loc && bun run boundaries && bun run lint:tailwind",
    "format": "oxfmt apps packages scripts",
    "boundaries": "bun scripts/check-boundaries.ts",
    "codegen": "bun scripts/codegen.ts",
    "codegen:check": "bun scripts/codegen.ts --check",
    "i18n:check": "bun scripts/i18n.ts check",
    "db:generate": "bun run --filter @intelluxiq/db generate",
    "db:migrate": "bun run --filter @intelluxiq/db migrate",
    "desktop": "bun scripts/desktop.ts run",
    "desktop:ui": "bun scripts/desktop-ui.ts run",
    "desktop:ui:web": "bun scripts/desktop-ui.ts run:web",
    "desktop:ui:build": "bun scripts/desktop-ui.ts build",
    "desktop:ui:check": "bun scripts/desktop-ui.ts check",
    "desktop:ui:test": "bun scripts/desktop-ui.ts test",
    "check": "bun run lint && bun run typecheck && bun run codegen:check && bun run i18n:check && bun run desktop:check",
    "dev:web": "bun run --filter @intelluxiq/web dev",
    "dev:api": "bun run --filter @intelluxiq/api dev",
    "dev:sync": "bun run --filter @intelluxiq/sync dev",
    "dev:worker": "bun run --filter @intelluxiq/worker dev",
    "dev:desktop": "bun scripts/desktop.ts run",
    "desktop:build": "bun scripts/desktop.ts build",
    "desktop:test": "bun scripts/desktop.ts test",
    "desktop:check": "bun scripts/desktop.ts check",
    "dev:cloud": "turbo run dev --parallel --filter=!@intelluxiq/desktop",
    "lint:tailwind": "bun scripts/lint-tailwind.ts",
    "format:check": "oxfmt --check apps packages scripts",
    "lint:loc": "bun scripts/check-file-length.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "tailwind-lint": "^0.17.0",
    "turbo": "^2.11.11",
    "typescript": "^7.0.2"
  }
}
