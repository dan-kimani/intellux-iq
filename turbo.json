{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "$TURBO_ROOT$/target/release/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": [
        "^build"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "lint": {}
  },
  "globalPassThroughEnv": [
    "CARGO_HOME",
    "CARGO_TARGET_DIR",
    "NSH_BIN",
    "RUST_LOG"
  ]
}
